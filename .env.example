# Copy the lines you need into .env (never commit .env).

# --- Explanations (optional) ---
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# --- Tracd Verify: Bolna voice calls ---
# Bolna dashboard -> API key. Without it every owner call is a labelled demo call.
BOLNA_API_KEY=
# Printed by: python -m fraudshield.voice.setup_agent
BOLNA_AGENT_ID=
# Optional: the number calls come from (E.164); empty = your Bolna account's default number
BOLNA_FROM_NUMBER=

# Demo owners' phones (E.164, e.g. +919812345678). Trial accounts can only call numbers VERIFIED in Bolna.
TRACD_DEMO_PHONE_FRAUD=
TRACD_DEMO_PHONE_HONEST=

# true = call even outside the agent's calling hours (for recording the demo at night)
VERIFY_BYPASS_GUARDRAILS=false

# Optional webhook. The app also polls Bolna every 3 s while a call runs, so this is NOT needed on a laptop.
# VERIFY_PUBLIC_URL=https://your-tunnel.trycloudflare.com
# VERIFY_WEBHOOK_SECRET=pick-a-long-random-string

# --- Laya (optional): the fine-tuned model served over HTTP ---
# LAYA_API_KEY=
